# Copy to .env.local for local dev. Real values live in Google Secret Manager
# in production (Cloud Run). Never commit a filled-in copy — .env* is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: connect to Cloud SQL through the Auth Proxy (or a local Postgres).
DATABASE_URL=postgresql://paperboy_app:PASSWORD@localhost:5432/paperboy
# Cloud Run only (when set, the app uses the Cloud SQL Unix socket and ignores
# DATABASE_URL): the instance connection name from the Cloud SQL "Connect" tab.
# INSTANCE_CONNECTION_NAME=paperboy-os-123456:us-central1:paperboy-db
DATABASE_USER=paperboy_app
DATABASE_NAME=paperboy
DATABASE_PASSWORD=

# ── Auth.js ───────────────────────────────────────────────────────────────────
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000     # the deployed Cloud Run URL in production
GOOGLE_OAUTH_ID=                   # OAuth client ID (staff Google sign-in)
GOOGLE_OAUTH_SECRET=               # OAuth client secret
ALLOWED_STAFF_DOMAIN=              # e.g. paperboy.com — restricts staff sign-in

# ── AI chat providers (Phase 3) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
EXIA_API_KEY=
EXIA_BASE_URL=                     # provided by you — Exia.ai is non-standard
EXIA_MODEL=
GLM_API_KEY=
GLM_MODEL=

# ── Exa.ai (dashboard news loop) ──────────────────────────────────────────────
# Neural search API (exa.ai) used to pull current CPG/consumer + investing news
# for the dashboard news rail. NOTE: distinct from the "Exia" chat provider above.
EXA_API_KEY=
# Shared secret the Cloud Scheduler cron sends to POST /api/admin/news/refresh.
NEWS_REFRESH_SECRET=

# ── MCP connector (staff add Paperboy to their own Claude) ────────────────────
# HS256 signing key for the MCP OAuth access tokens (app/api/mcp). Falls back to
# AUTH_SECRET if unset. openssl rand -base64 32
MCP_TOKEN_SECRET=

# ── Google Drive ingestion (Phase 3) ──────────────────────────────────────────
SHARED_DRIVE_ID=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-005

# ── Google Sync (push notifications for Gmail/Calendar/Drive) ────────────────
# Pub/Sub topic for Gmail push (created via gcloud pubsub topics create gmail-push)
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-push
# Shared secret for webhook verification and Cloud Scheduler sync calls
SYNC_WEBHOOK_SECRET=

# ── Beehiiv newsletter (in-app Newsletter module) ─────────────────────────────
# Beehiiv → Settings → API. The module is staff-only; the key stays server-side.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=            # e.g. pub_xxxxxxxx-xxxx-...
BEEHIIV_SEND_ENABLED=false         # true only if your plan has the Send API (Enterprise/beta)

# ── Squarespace → CRM intake (app/api/intake/brand-application) ───────────────
# Shared token the Squarespace form (or Zapier step) must send as ?token=… or
# x-intake-token. Endpoint fails closed when unset. openssl rand -hex 24
INTAKE_WEBHOOK_SECRET=
